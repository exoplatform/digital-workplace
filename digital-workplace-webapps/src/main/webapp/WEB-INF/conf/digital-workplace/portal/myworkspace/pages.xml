<?xml version="1.0" encoding="UTF-8"?>
<page-set xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/gatein_objects_1_8 http://www.exoplatform.org/xml/ns/gatein_objects_1_8"
  xmlns="http://www.exoplatform.org/xml/ns/gatein_objects_1_8">

  <page>
    <name>dashboard</name>
    <title>Dashboard</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <css-style>
        <background-color>#F2F2F2FF</background-color>
        <background-image>/digital-workplace/images/background/myWorkspace/top.webp</background-image>
        <background-position>top left</background-position>
        <background-size>contain</background-size>
      </css-style>
      <section-columns
        sticky-beahvior="false"
        mobile-columns-style="false">
        <css-style>
          <margin-top>60</margin-top>
          <margin-bottom>20</margin-bottom>
        </css-style>
        <column col-span="3">
          <portlet-application>
            <portlet>
              <application-ref>social</application-ref>
              <portlet-ref>ProfileHeader</portlet-ref>
              <preferences>
                <preference>
                  <name>avatarMinSize</name>
                  <value>40</value>
                </preference>
                <preference>
                  <name>avatarMaxSize</name>
                  <value>80</value>
                </preference>
                <preference>
                  <name>bannerHeight</name>
                  <value>100</value>
                </preference>
                <preference>
                  <name>bannerMaxHeight</name>
                  <value>175</value>
                </preference>
                <preference>
                  <name>displayOption</name>
                  <value>welcome</value>
                </preference>
              </preferences>
            </portlet>
            <title></title>
            <cssClass>hidden-sm-and-down</cssClass>
            <css-style>
              <margin-top>40</margin-top>
              <margin-bottom>16</margin-bottom>
              <margin-right>20</margin-right>
              <margin-left>20</margin-left>
              <radius-top-right>8</radius-top-right>
              <radius-top-left>8</radius-top-left>
              <radius-bottom-right>0</radius-bottom-right>
              <radius-bottom-left>0</radius-bottom-left>
              <background-color>#FFFFFFF0</background-color>
            </css-style>
          </portlet-application>
          <portlet-application profiles="notes">
            <portlet>
              <application-ref>notes</application-ref>
              <portlet-ref>NotePageView</portlet-ref>
              <preferences>
                <preference>
                  <name>data.init</name>
                  <value>
                    <![CDATA[
                      {
                         "pages":{
                            "":"<p>Your personal dashboard gives you quick and centralized access to your apps and tools:&nbsp;</p><p>💼 Your work apps</p><p>📁 Your files</p><p>📅 Your agenda &amp; tasks</p>",
                            "fr":"<p>Votre tableau de bord personnel vous donne un accès rapide à vos outils:&nbsp;</p><p>💼 Vos applications pro</p><p>📁 Vos fichiers</p><p>📅 Votre agenda et vos tâches</p>"
                         }
                      }
                    ]]>
                  </value>
                </preference> 
              </preferences>
            </portlet>
            <title></title>
            <height>250</height>
            <cssClass>hidden-sm-and-down</cssClass>
            <css-style>
              <margin-top>0</margin-top>
              <margin-bottom>20</margin-bottom>
              <margin-right>20</margin-right>
              <margin-left>20</margin-left>
              <radius-top-right>0</radius-top-right>
              <radius-top-left>0</radius-top-left>
              <radius-bottom-right>8</radius-bottom-right>
              <radius-bottom-left>8</radius-bottom-left>
              <background-color>#FFFFFFF0</background-color>
            </css-style>
          </portlet-application>
        </column>        
		<column col-span="3">
          <portlet-application profiles="app-center">
            <portlet>
              <application-ref>app-center</application-ref>
              <portlet-ref>AppCenterMyApplicationsPortlet</portlet-ref>
            </portlet>
            <title>My apps</title>
            <height>425</height>
            <cssClass>hidden-sm-and-down</cssClass>
            <css-style>
              <margin-top>40</margin-top>
              <margin-bottom>20</margin-bottom>
              <margin-right>20</margin-right>
              <margin-left>20</margin-left>
              <background-color>#FFFFFFF0</background-color>
            </css-style>
          </portlet-application>
        </column>
        <column col-span="3">
          <portlet-application profiles="task">
            <portlet>
              <application-ref>task-management</application-ref>
              <portlet-ref>tasks</portlet-ref>
            </portlet>
            <title>My Tasks</title>
            <height>425</height>
            <cssClass>hidden-sm-and-down</cssClass>
            <css-style>
              <margin-top>40</margin-top>
              <margin-bottom>20</margin-bottom>
              <margin-right>20</margin-right>
              <margin-left>20</margin-left>
              <background-color>#FFFFFFF0</background-color>
            </css-style>
          </portlet-application>
        </column>
		<column col-span="3">
          <portlet-application profiles="agenda">
            <portlet>
              <application-ref>agenda</application-ref>
              <portlet-ref>AgendaTimeline</portlet-ref>
            </portlet>
            <title>Agenda Timeline</title>
            <height>425</height>
            <cssClass>hidden-sm-and-down</cssClass>
            <css-style>
              <margin-top>40</margin-top>
              <margin-bottom>20</margin-bottom>
              <margin-right>20</margin-right>
              <margin-left>20</margin-left>
              <background-color>#FFFFFFF0</background-color>
            </css-style>
          </portlet-application>
        </column>
      </section-columns>
      <section-columns
        sticky-beahvior="true"
        mobile-columns-style="true">
        <css-style>
          <margin-top>20</margin-top>
          <margin-bottom>20</margin-bottom>
          <background-image>/digital-workplace/images/background/myWorkspace/bottom.webp</background-image>
          <background-effect>linear-gradient(#4D87C7FF, #FFFFFFFF)</background-effect>
          <background-position>top left</background-position>
          <background-repeat>no-repeat</background-repeat>
        </css-style>
        <column col-span="8">
          <portlet-application>
            <portlet>
              <application-ref>social</application-ref>
              <portlet-ref>UserActivityStreamPortlet</portlet-ref>
            </portlet>
            <title>User Feed</title>
          </portlet-application>
        </column>
        <column col-span="4">
          <portlet-application profiles="gamification">
            <portlet>
              <application-ref>gamification-portlets</application-ref>
              <portlet-ref>myContributions</portlet-ref>
              <preferences>
                <preference>
                  <name>myContributionsPeriod</name>
                  <value>quarter</value>
                </preference>
                <preference>
                  <name>myContributionsDisplayLegend</name>
                  <value>true</value>
                </preference>
                <preference>
                  <name>myContributionsProgramLimit</name>
                  <value>3</value>
                </preference>
              </preferences>
            </portlet>
            <title>Current Contributions</title>
          </portlet-application>
          <portlet-application profiles="documents">
            <portlet>
              <application-ref>documents-portlet</application-ref>
              <portlet-ref>DocumentsSizeGadget</portlet-ref>
            </portlet>
            <title>Documents Size Gadget</title>
          </portlet-application>
          <portlet-application profiles="analytics">
            <portlet>
              <application-ref>analytics</application-ref>
              <portlet-ref>SpacesListWidget</portlet-ref>
              <preferences>
                <preference>
                  <name>userSpacesLimit</name>
                  <value>1</value>
                </preference>
                <preference>
                  <name>spacesRecentlyVisitedLimit</name>
                  <value>1</value>
                </preference>
              </preferences>
            </portlet>
            <title>Space list</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
  <page>
    <name>drives</name>
    <title>Drive</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <section-columns
        sticky-beahvior="false"
        mobile-columns-style="true">
        <column col-span="8">
          <portlet-application>
            <portlet>
              <application-ref>documents-portlet</application-ref>
              <portlet-ref>DocumentGadget</portlet-ref>
              <preferences>
                <preference>
                  <name>viewOptions</name>
                  <value>cards</value>
                </preference>
                <preference>
                  <name>customHeader</name>
                  <value>false</value>
                </preference>
                <preference>
                  <name>displaySeeMore</name>
                  <value>true</value>
                </preference>
                <preference>
                  <name>maxDocumentsToList</name>
                  <value>4</value>
                </preference>
                <preference>
                  <name>documentType</name>
                  <value>recentDocument</value>
                </preference>
              </preferences>
            </portlet>
          </portlet-application>
        </column>
        <column col-span="4">
          <portlet-application>
            <portlet>
              <application-ref>documents-portlet</application-ref>
              <portlet-ref>DocumentGadget</portlet-ref>
              <preferences>
                <preference>
                  <name>viewOptions</name>
                  <value>list</value>
                </preference>
                <preference>
                  <name>customHeader</name>
                  <value>false</value>
                </preference>
                <preference>
                  <name>displaySeeMore</name>
                  <value>true</value>
                </preference>
                <preference>
                  <name>maxDocumentsToList</name>
                  <value>4</value>
                </preference>
                <preference>
                  <name>documentType</name>
                  <value>sharedWithMe</value>
                </preference>
              </preferences>
            </portlet>
            <height>300</height>
          </portlet-application>
        </column>
      </section-columns>
      <section-columns
        sticky-beahvior="false"
        mobile-columns-style="true">
        <column col-span="12">
          <portlet-application>
            <portlet>
              <application-ref>documents-portlet</application-ref>
              <portlet-ref>Documents</portlet-ref>
            </portlet>
            <title>Documents Application</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
  <page>
    <name>tasks</name>
    <title>Tasks</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <section-columns>
        <column col-span="12">
          <portlet-application>
            <portlet>
              <application-ref>task-management</application-ref>
              <portlet-ref>TasksManagement</portlet-ref>
            </portlet>
            <title>Tasks</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
  <page>
    <name>agenda</name>
    <title>Agenda</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <section-columns>
        <column col-span="12">
          <portlet-application>
            <portlet>
              <application-ref>agenda</application-ref>
              <portlet-ref>Agenda</portlet-ref>
            </portlet>
            <title>Agenda</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
  <page>
    <name>processes</name>
    <title>Processes</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <section-columns>
        <column col-span="12">
          <portlet-application>
            <portlet>
              <application-ref>processes</application-ref>
              <portlet-ref>Processes</portlet-ref>
            </portlet>
            <title>Processes</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
  <page>
    <name>news</name>
    <title>News</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <section-columns>
        <column col-span="12">
          <portlet-application>
            <portlet>
              <application-ref>content</application-ref>
              <portlet-ref>News</portlet-ref>
            </portlet>
            <title>News</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
  <page>
    <name>myteam</name>
    <title>My Team</title>
    <access-permissions>*:/platform/users;*:/platform/externals</access-permissions>
    <edit-permission>*:/platform/administrators</edit-permission>
    <container template="system:/groovy/portal/webui/container/UIPageLayout.gtmpl">
      <section-columns>
        <column col-span="12">
          <portlet-application>
            <portlet>
              <application-ref>social</application-ref>
              <portlet-ref>OrganizationalChart</portlet-ref>
              <preferences>
                <preference>
                  <name>centerUser</name>
                  <value>@connected@</value>
                  <read-only>true</read-only>
                </preference>
                <preference>
                  <name>headerTitle</name>
                  <value>organizationalChart.header.myTeam</value>
                  <read-only>true</read-only>
                </preference>
              </preferences>
            </portlet>
            <title>Organizational Chart</title>
          </portlet-application>
        </column>
      </section-columns>
    </container>
  </page>
</page-set>
